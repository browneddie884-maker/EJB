# Copy to .env (or set these in the hosting dashboard) before launch.
# Every tracking ID is optional: leave one empty and that tool stays off.

# Live site address, used for the sitemap, robots.txt and canonical links.
VITE_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (Admin > Data streams), e.g. G-ABC123XYZ
VITE_GA_ID=

# Google Ads tag ID and the conversion label of the "Booking" conversion action
# (Goals > Conversions > the action > Tag setup > Install the tag yourself), e.g. AW-123456789 and AbCdEfGhIjk
VITE_GADS_ID=
VITE_GADS_BOOKING_LABEL=

# Meta (Facebook/Instagram) Pixel ID from Events Manager, e.g. 1234567890123456
VITE_META_PIXEL_ID=

# Staff PIN fingerprint: sha256 of "motion-staff:<PIN>". Default PIN is 2468; change it before launch.
VITE_STAFF_PIN_HASH=
